exec_always swaybg -i ~/Pictures/anime-moon-landscape.jpg -m fill
bindsym $mod+Shift+x exec i3lock


bindsym Print exec grimshot save screen
bindsym Shift+Print exec grimshot save area
exec waybar

input "1133:49271:Logitech_USB_Optical_Mouse" {
	accel_profile "flat"
	pointer_accel 0
}

input type:keyboard {
    xkb_layout "fr"
}

output * scale 2

corner_radius 10

shadows enable
shadow_blur_radius 5
shadow_color #00000080
shadow_inactive_color #00000040

set $gnome-schema org.gnome.desktop.interface
exec_always {
    gsettings set $gnome-schema gtk-theme 'Adwaita-dark'
    gsettings set $gnome-schema icon-theme 'Papirus-Dark'
    gsettings set $gnome-schema cursor-theme 'elementary'
}

